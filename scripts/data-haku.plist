<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Datan haku koneelta (5.11.2026), scripts/data-haku.mjs --ajastettu: Search Console, Merchant, Instagram, TikTok.
     Käynnistyy joka tunti :05. Skripti hakee vain maanantaina klo 8 jälkeen Suomen aikaa, kerran viikossa.
     Asennus: bash ~/huumorikauppa/scripts/data-haku-asennus.sh
     NODE ja KOTI korvataan asennuksessa. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>fi.huumorikauppa.data-haku</string>
  <key>ProgramArguments</key>
  <array>
    <string>NODE</string>
    <string>KOTI/huumorikauppa/scripts/data-haku.mjs</string>
    <string>--ajastettu</string>
  </array>
  <key>WorkingDirectory</key><string>KOTI/huumorikauppa</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>5</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>KOTI/.huumorikauppa-some/datahaku-launchd.log</string>
  <key>StandardErrorPath</key><string>KOTI/.huumorikauppa-some/datahaku-launchd.log</string>
</dict>
</plist>
