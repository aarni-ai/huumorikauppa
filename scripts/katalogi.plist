<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Staattinen katalogi (5.11.2026), scripts/katalogi.mjs --ajastettu --julkaise: tietokannan tuotteet (kun kanta vastaa),
     Printifyn saatavuus, julkaisu vain muutoksesta. Käynnistyy tunnin välein :04, ajo kerran päivässä klo 7 jälkeen Suomen aikaa (valvonnan heräämisen kanssa).
     Asennus: bash ~/huumorikauppa/scripts/ajastus-asennus.sh katalogi
     NODE ja KOTI korvataan asennuksessa. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>fi.huumorikauppa.katalogi</string>
  <key>ProgramArguments</key>
  <array>
    <string>NODE</string>
    <string>KOTI/huumorikauppa/scripts/katalogi.mjs</string>
    <string>--ajastettu</string>
    <string>--julkaise</string>
  </array>
  <key>WorkingDirectory</key><string>KOTI/huumorikauppa</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>4</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>KOTI/.huumorikauppa-some/katalogi-launchd.log</string>
  <key>StandardErrorPath</key><string>KOTI/.huumorikauppa-some/katalogi-launchd.log</string>
</dict>
</plist>
