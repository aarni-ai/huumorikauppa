{
  "functions": {
    "api/img.js": {
      "includeFiles": [
        "node_modules/sharp/**/*",
        "node_modules/@img/sharp-linux-x64/**/*",
        "node_modules/@img/sharp-libvips-linux-x64/**/*"
      ]
    }
  },
  "redirects": [
    {
      "source": "/tuote/-jos-iska-ei-osaa-korjata-sita-t-paita",
      "destination": "/tuote/jos-iska-ei-osaa-korjata-sita-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/amatimies-t-paita-02f10a",
      "destination": "/tuote/amatimies-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/amatimies-huppari-0e3e76",
      "destination": "/tuote/amatimies-huppari",
      "permanent": true
    },
    {
      "source": "/tuote/100-elakalainen-kahvikuppi",
      "destination": "/tuote/100-elakelainen-kahvikuppi",
      "permanent": true
    },
    {
      "source": "/syntymapaivaLahjat",
      "destination": "/syntymapaivalahjat",
      "permanent": true
    },
    {
      "source": "/tuotteet",
      "destination": "/kaikki-tuotteet",
      "permanent": true
    },
    {
      "source": "/tuotteet/:path*",
      "destination": "/kaikki-tuotteet",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product-feed.xml",
      "destination": "/api/product-feed"
    },
    {
      "source": "/((?!.*\\.(?:xml|txt|json|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|otf|pdf|map)$).*)",
      "destination": "/index.html"
    }
  ]
}
