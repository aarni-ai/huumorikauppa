{
  "functions": {
    "api/img.js": {
      "includeFiles": "node_modules/{sharp,@img/sharp-linux-x64,@img/sharp-libvips-linux-x64}/**/*"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.huumorikauppa.fi"
        }
      ],
      "destination": "https://huumorikauppa.fi/$1",
      "permanent": true
    },
    {
      "source": "/tuote/-jos-iska-ei-osaa-korjata-sita-t-paita",
      "destination": "/tuote/jos-iska-ei-osaa-korjata-sita-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/amatimies-t-paita-02f10a",
      "destination": "/tuote/amatimies-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/amatimies-huppari-0e3e76",
      "destination": "/tuote/amatimies-huppari",
      "permanent": true
    },
    {
      "source": "/tuote/100-elakalainen-kahvikuppi",
      "destination": "/tuote/100-elakelainen-kahvikuppi",
      "permanent": true
    },
    {
      "source": "/syntymapaivaLahjat",
      "destination": "/syntymapaivalahjat",
      "permanent": true
    },
    {
      "source": "/tuotteet",
      "destination": "/kaikki-tuotteet",
      "permanent": true
    },
    {
      "source": "/tuotteet/:path*",
      "destination": "/kaikki-tuotteet",
      "permanent": true
    },
    {
      "source": "/tuote/level-30-selka-rusahtaa-nyt-t-paita",
      "destination": "/tuote/30v-selka-alkaa-jo-rusahdella-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/level-30-selka-rusahtaa-nyt-huppari",
      "destination": "/tuote/30v-selka-alkaa-jo-rusahdella-huppari",
      "permanent": true
    },
    {
      "source": "/tuote/level-30-selka-rusahtaa-nyt-muki",
      "destination": "/tuote/30v-selka-alkaa-jo-rusahdella-muki",
      "permanent": true
    },
    {
      "source": "/tuote/40v-kunto-kuin-20v-20-vuotta-sitten-t-paita",
      "destination": "/tuote/40v-kunnossa-niinku-20v-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/40v-kunto-kuin-20v-20-vuotta-sitten-huppari",
      "destination": "/tuote/40v-kunnossa-niinku-20v-huppari",
      "permanent": true
    },
    {
      "source": "/tuote/40v-kunto-kuin-20v-20-vuotta-sitten-muki",
      "destination": "/tuote/40v-kunnossa-niinku-20v-muki",
      "permanent": true
    },
    {
      "source": "/tuote/30-ja-loistossaan-t-paita",
      "destination": "/tuote/30-nuori-villi-ja-jo-vasynyt-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/30-ja-loistossaan-huppari",
      "destination": "/tuote/30-nuori-villi-ja-jo-vasynyt-huppari",
      "permanent": true
    },
    {
      "source": "/tuote/30-ja-loistossaan-muki",
      "destination": "/tuote/30-nuori-villi-ja-jo-vasynyt-muki",
      "permanent": true
    },
    {
      "source": "/tuote/50v-klassikkomalli-t-paita",
      "destination": "/tuote/50-vuotta-nuori-t-paita",
      "permanent": true
    },
    {
      "source": "/tuote/50v-klassikkomalli-huppari",
      "destination": "/tuote/50-vuotta-nuori-huppari",
      "permanent": true
    },
    {
      "source": "/tuote/50v-klassikkomalli-muki",
      "destination": "/tuote/50-vuotta-nuori-muki",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product-feed.xml",
      "destination": "/api/product-feed"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!.*\\.(?:xml|txt|json|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|otf|pdf|map)$).*)",
      "destination": "/index.html"
    }
  ]
}
